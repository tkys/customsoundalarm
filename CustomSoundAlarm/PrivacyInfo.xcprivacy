<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Privacy Manifest for My Sound Alarm.
		PostHog SDK 同梱の PrivacyInfo.xcprivacy に加え、アプリ本体が原因で収集される
		データを申告する。トラッキングには使用しない（NSPrivacyTracking = false）。
		PII（メール等）は一切送信せず、ユーザー識別は PostHog 既定の匿名IDによる。

		App Store Connect の「App のプライバシー」表示と必ず一致させること。
		収集データ種別・リンク有無・トラッキング有無・目的のどれかを変えるときは、
		このファイルと ASC の両方を更新する（#167）。

		1.9.0 で広告を入れる際は、Google Mobile Ads SDK 側の
		PrivacyInfo.xcprivacy / ASC の申告と合わせてこのファイルを見直すこと。
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
			Product Interaction: アラーム作成・サウンドインポート・試聴などの
			プロダクト利用状況イベント。匿名IDに紐づくが、ユーザー身元とはリンクしない。
			ASC に合わせて目的は Analytics のみ（AppFunctionality は付けない）。
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!--
			Coarse Location: PostHog が IP から国・都市を推定する（IP 自体は
			2026-11-04 から破棄設定）。イベントの地域別集計にのみ使い、
			ユーザー身元とはリンクせず、トラッキングには使わない。
			ASC に合わせて目的は Analytics のみ。
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!--
			Other Diagnostic Data: PostHog SDK が付与するデバイス/アプリのコンテキスト情報
			（OS バージョン・アプリバージョン・デバイス種別・ロケール等）。
			ASC に合わせて目的は Analytics のみ（AppFunctionality は付けない）。
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
			UserDefaults: PostHog SDK が匿名ID・セッション・イベントキューを永続化するために使用。
			CA92.1 = サードパーティ SDK がアクセス情報に保存されたデータへアクセスするため。
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
