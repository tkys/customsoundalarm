<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>playlist_delete_message_count_fmt</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@alarms@</string>
        <key>alarms</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
        <key>one</key>
        <string>1 budík používá tento playlist. Pokud jej smažete, bude zvonit zvukem první skladby playlistu.</string>
        <key>few</key>
        <string>%d budíky používají tento playlist. Pokud jej smažete, budou zvonit zvukem první skladby playlistu.</string>
        <key>other</key>
        <string>%d budíků používá tento playlist. Pokud jej smažete, budou zvonit zvukem první skladby playlistu.</string>
        </dict>
    </dict>
</dict>
</plist>
